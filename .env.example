SARIFPRO_SUPABASE_URL=https://your-project.supabase.co
SARIFPRO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SARIFPRO_SUPABASE_USE_ANONYMOUS_AUTH=false

# Android release signing. Keep real values out of git.
SARIFPRO_RELEASE_STORE_FILE=android/app/sarifpro-release.keystore
SARIFPRO_RELEASE_STORE_PASSWORD=replace-me
SARIFPRO_RELEASE_KEY_ALIAS=sarifpro
SARIFPRO_RELEASE_KEY_PASSWORD=replace-me
